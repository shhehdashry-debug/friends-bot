                bot.send_message(chat_id, "❌ لم يتم العثور على PID.")
                return
            pid = match.group(1)
            user_recharge_states[chat_id]['asia_login_state']['pid'] = pid
            msg = bot.send_message(chat_id, "💬 أدخل رمز التحقق SMS الذي وصلك:")
            bot.register_next_step_handler(msg, process_user_asiacell_passcode_for_charge)
        else:
            bot.send_message(chat_id, f"❌ فشل إرسال الرقم: {data_login.get('message', data_login)}")
    except Exception as e:
        bot.send_message(chat_id, f"❌ خطأ: {e}")

def process_user_asiacell_passcode_for_charge(message):
