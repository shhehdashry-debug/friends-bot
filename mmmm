        bot.answer_callback_query(call.id, "❌ الزر غير موجود", show_alert=True)
        return True

    target = src - 1 if direction == "up" else src + 1
    if target < 0 or target >= len(rows):
        bot.answer_callback_query(call.id, "⚠️ ماكو صف بهذا الاتجاه", show_alert=True)
        return True

    # الصف المقصود يسمح بحد أقصى زرين عند النقل.
    # دمج 3 أزرار يتم من إعدادات الصف/التقسيم، أما النقل فلا ينشئ
    # صفاً مزدحماً أو يكسر الصفوف الموجودة.
    if len(rows[target]) >= 2:
        bot.answer_callback_query(
            call.id,
            "⚠️ الصف المقصود يحتوي زرين بالفعل. استخدم «تحديد زرين» أو افصل الصف أولاً.",
            show_alert=True
        )
        return True

    rows[src].remove(cb)
    if not rows[src]:
        rows.pop(src)
        if src < target:
            target -= 1

    rows[target].append(cb)

    cfg["rows"] = rows
    cfg["order"] = [x for row in rows for x in row]
    all_data[menu_key] = cfg
    _save_button_layouts(all_data)

    bot.answer_callback_query(call.id, "✅ تم نقل الزر بنجاح")
    _show_layout_editor(call.message.chat.id, call.message.message_id, menu_key)
    return True


def _show_layout_hide_buttons(call, menu_key):
    cfg = _normalize_layout_cfg(menu_key)
    labels = _layout_labels(cfg)
    hidden = set(cfg.get("hidden", []))

    kb = types.InlineKeyboardMarkup(row_width=1)
    for row_index, row in enumerate(cfg.get("rows", [])):
        for col_index, cb in enumerate(row):
            state = "🚫 مخفي" if cb in hidden else "✅ ظاهر"
            kb.add(types.InlineKeyboardButton(
                f"{state} | {labels.get(cb, cb)}",
                callback_data=f"layout_hide_cb|{menu_key}|{row_index}|{col_index}"
            ))

    kb.add(types.InlineKeyboardButton(
        "🔙 رجوع",
        callback_data=f"layout_menu|{menu_key}"
    ))

    bot.edit_message_text(
        "👁️ **إظهار / إخفاء الأزرار**\n\n"
        "اضغط على أي زر لتبديل حالته.",
        call.message.chat.id,
        call.message.message_id,
        reply_markup=kb,
        parse_mode="Markdown"
    )


