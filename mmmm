def update_points(user_id, amount, is_recharge=False):
    u = get_user(user_id)
    if u:
        current = float(u.get('points', 0.0) or 0.0)
        new_points = round(current + float(amount), 2)
        update_data = {"points": new_points}
        cached_user = dict(u)
        cached_user["points"] = new_points
        if is_recharge and amount > 0:
            old_recharged = float(u.get('total_recharged', 0.0) or 0.0)
            new_recharged = round(old_recharged + float(amount), 2)
            update_data["total_recharged"] = new_recharged
            cached_user["total_recharged"] = new_recharged
        supabase.table("users").update(update_data).eq("user_id", user_id).execute()
        invalidate_user_cache(user_id, cached_user)
    else:
        new_points = max(0.0, float(amount))
        data = {"user_id": user_id, "points": new_points}
        if is_recharge and amount > 0:
            data["total_recharged"] = float(amount)
        supabase.table("users").insert(data).execute()
        invalidate_user_cache(user_id, data)

