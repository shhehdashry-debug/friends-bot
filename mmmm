                cfg_now = _normalize_layout_cfg(key)
                first = _layout_cb_at(cfg_now, first_r, first_c)
                second = _layout_cb_at(cfg_now, second_r, second_c)
            else:
                # توافق مع callback قديم.
                _, key, first, second = data.split("|", 3)
                cfg_now = _normalize_layout_cfg(key)
            if not first or not second or first == second:
                bot.answer_callback_query(call.id, "❌ أحد الأزرار غير موجود", show_alert=True)
