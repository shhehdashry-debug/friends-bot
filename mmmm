USER_CACHE = {}
USER_CACHE_TTL = 5  # ثواني

def get_user(user_id, force_refresh=False):
    now = time.time()
    cached = USER_CACHE.get(user_id)
    if not force_refresh and cached and now - cached[0] < USER_CACHE_TTL:
        return cached[1]
    try:
        res = supabase.table("users").select("*").eq("user_id", user_id).execute()
        user = res.data[0] if res.data else None
        USER_CACHE[user_id] = (now, user)
        return user
    except Exception as e:
        print(f"Error fetching user: {e}")
        return cached[1] if cached else None

def invalidate_user_cache(user_id, user_data=None):
    if user_data is None:
        USER_CACHE.pop(user_id, None)
