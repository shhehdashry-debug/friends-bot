def process_admin_broadcast_execution(message):
    chat_id = message.chat.id
    if chat_id != ADMIN_ID: return
    st = admin_states.get(chat_id)
    if not st or st.get('action') != 'broadcast':
        return
    b_type = st.get('type')
    del admin_states[chat_id]
    
    start_time = time.time()
    try:
        page = 0
        batch_size = 1000
        success = 0
        blocked = 0
        failed = 0
        now = time.time()
        
        while True:
            res = supabase.table("users").select("user_id, last_order_ts").range(page * batch_size, (page + 1) * batch_size - 1).execute()
            users = res.data if res.data else []
            if not users:
                break

            for u in users:
                uid = u['user_id']
                if b_type == 'inactive':
                    last_o = u.get('last_order_ts', 0)
                    if now - last_o < 604800:
                        continue
                        
                try:
                    sent_msg = bot.copy_message(chat_id=uid, from_chat_id=chat_id, message_id=message.message_id)
                    if b_type == 'pin':
                        try:
                            bot.pin_chat_message(chat_id=uid, message_id=sent_msg.message_id)
                        except Exception:
                            pass
                    success += 1
                    time.sleep(0.04)
                except Exception as e:
                    err_str = str(e).lower()
                    if "blocked" in err_str or "deactivated" in err_str or "chat not found" in err_str:
                        blocked += 1
                    else:
                        failed += 1
            
            if len(users) < batch_size:
                break
            page += 1

        elapsed_time = round(time.time() - start_time, 2)
        report_text = (
            f"📢 **تقرير الإذاعة التفصيلي:**\n"
            f"━━━━━━━━━━━━━━━━━━━\n\n"
            f"🟢 وصلَت بنجاح: `{success}` مستخدم\n"
            f"🔴 حظروا البوت (أو غير مفعل): `{blocked}` شخص\n"
            f"⚠️ فشل الإرسال (أخطاء أخرى): `{failed}` شخص\n"
            f"⏱️ استغرقت العملية: `{elapsed_time}` ثانية"
        )
        bot.send_message(chat_id, report_text, parse_mode="Markdown")
    except Exception as e:
        bot.send_message(chat_id, f"❌ حدث خطأ أثناء الإذاعة: {e}")

