                print(f"Error in buytier handler: {e}")

        elif data == 'confirm_order_now':
            if chat_id in processing_order_users:
                bot.answer_callback_query(call.id, "⏳ الطلب قيد المعالجة، انتظر قليلاً.", show_alert=True)
                return
            processing_order_users.add(chat_id)
