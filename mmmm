def admin_process_transfer_passcode_final(message):
    if message.from_user.id != ADMIN_ID: return
    passcode = message.text.strip()
    target_user_id = admin_asia_data.get('current_transfer_target_user')
    transfer_info = admin_asia_data['pending_transfers'].get(target_user_id)

    if not transfer_info:
        bot.send_message(ADMIN_ID, "❌ الطلب غير موجود.")
        return

    try:
        data_confirm = send_asia_credit_transfer_confirm_request(
            transfer_info['transfer_pid'],
            passcode,
            admin_asia_data['admin_asia_access_token']
        )
        if data_confirm.get("success"):
            update_points(target_user_id, transfer_info['amount'], is_recharge=True)
            bot.send_message(ADMIN_ID, f"✅ تم تحويل الرصيد وإضافة {transfer_info['amount']} نقطة للمستخدم {target_user_id} بنجاح!")
            bot.send_message(target_user_id, f"🎉 تم شحن رصيدك بنجاح بمبلغ {transfer_info['amount']}$!")
            del admin_asia_data['pending_transfers'][target_user_id]
        else:
            bot.send_message(ADMIN_ID, f"❌ فشل التأكيد: {data_confirm.get('message', data_confirm)}")
    except Exception as e:
        bot.send_message(ADMIN_ID, f"❌ خطأ فني: {e}")

@bot.message_handler(commands=['start', 'redeem', 'admin'])
def handle_commands(message):
    chat_id = message.chat.id
    text = message.text

    if text.startswith('/start'):
        args = text.split()
        param = args[1] if len(args) > 1 else None
        
        if param and param.startswith('CARD-'):
            message.text = param
            process_user_redeem_input(message)
            return

        referrer_id = param if param and param != str(chat_id) and param.isdigit() else None
        
        try:
            first_name = message.from_user.first_name or "بدون اسم"
            username = message.from_user.username or "لا يوجد"
            start_user_data = register_user_if_new(chat_id, first_name, username, referrer_id)
        except Exception as e:
            print(f"Error registering user in handler: {e}")
            start_user_data = None

        if start_user_data and bool(start_user_data.get('is_banned', 0)):
            return

        if chat_id != ADMIN_ID:
            try:
                if not check_sub(chat_id):
                    markup = types.InlineKeyboardMarkup()
                    for i in range(len(CHANNELS)):
                        markup.add(types.InlineKeyboardButton("اشترك في القناة 📢", url=CHANNEL_LINKS[i], style=get_item_style(CHANNEL_LINKS[i])))
                    markup.add(types.InlineKeyboardButton("تحققت من الاشتراك ✅", callback_data='start', style=get_item_style('start')))
                    bot.send_message(chat_id, "عذراً، يجب عليك الاشتراك في القناة أولاً لتتمكن من استخدام البوت:", reply_markup=markup)
                    return
            except Exception as e:
                print(f"Error checking subscription: {e}")

        main_menu(chat_id, user_data=start_user_data)

    elif text.startswith('/admin') and chat_id == ADMIN_ID:
        admin_panel_shortcut(chat_id)

