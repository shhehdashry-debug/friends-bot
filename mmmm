BUTTON_LAYOUTS_KEY = "button_layouts_v2"
_BUTTON_LAYOUTS_CACHE = None


def _load_button_layouts():
    global _BUTTON_LAYOUTS_CACHE
    if _BUTTON_LAYOUTS_CACHE is not None:
        return _BUTTON_LAYOUTS_CACHE
    try:
        res = supabase.table("settings").select("val_text").eq("key", BUTTON_LAYOUTS_KEY).execute()
        raw = res.data[0].get("val_text") if res.data else ""
        data = json.loads(raw) if raw else {}
        _BUTTON_LAYOUTS_CACHE = data if isinstance(data, dict) else {}
    except Exception as e:
        print(f"Button layouts load error: {e}")
        _BUTTON_LAYOUTS_CACHE = {}
    return _BUTTON_LAYOUTS_CACHE


def _save_button_layouts(data):
    global _BUTTON_LAYOUTS_CACHE
    supabase.table("settings").upsert({
        "key": BUTTON_LAYOUTS_KEY,
        "val_text": json.dumps(data, ensure_ascii=False)
    }).execute()
    _BUTTON_LAYOUTS_CACHE = data


def _layout_snapshot(menu_key, markup):
    """يحفظ أسماء/callbacks القائمة الحالية مع إبقاء إعدادات الأدمن."""
    key = str(menu_key)
    items = []
    for row in getattr(markup, "keyboard", []):
        for btn in row:
            cb = getattr(btn, "callback_data", None)
            if cb:
                items.append({"callback": str(cb), "text": str(getattr(btn, "text", "زر"))})
    if not items:
        return
    data = dict(_load_button_layouts())
    old = dict(data.get(key, {}))
    old_buttons = old.get("buttons", [])
    old["buttons"] = items
    if not old.get("order"):
        old["order"] = [x["callback"] for x in items]
    if not old.get("rows"):
        old["rows"] = [[x["callback"]] for x in items]
    else:
        live = [x["callback"] for x in items]
        seen = {cb for row in old["rows"] for cb in row}
        old["rows"] = [[cb for cb in row if cb in live] for row in old["rows"]]
        old["rows"] = [row for row in old["rows"] if row]
        old["rows"] += [[cb] for cb in live if cb not in seen]
    data[key] = old
    cached_old = _load_button_layouts().get(key, {})
    if cached_old.get("buttons") == items and cached_old.get("order") == old.get("order") and cached_old.get("hidden", []) == old.get("hidden", []) and cached_old.get("columns", 1) == old.get("columns", 1):
        return
    try:
        _save_button_layouts(data)
    except Exception as e:
        print(f"Button layout snapshot save error: {e}")


def _apply_button_layout(menu_key, markup):
    """يطبق الترتيب اليدوي، بما فيه الصفوف المخصصة، على القائمة الحالية."""
    cfg = _load_button_layouts().get(str(menu_key), {})
    if not cfg:
        return markup

    hidden = {str(x) for x in cfg.get("hidden", [])}
    buttons = {}
    plain = []
    for row in getattr(markup, "keyboard", []):
        for b in row:
            cb = getattr(b, "callback_data", None)
            if cb:
                buttons[str(cb)] = b
            else:
                plain.append(b)

    rows_cfg = cfg.get("rows")
    if rows_cfg:
        result=[]; used=set()
        for row in rows_cfg:
            out=[]
            for cb in row:
                cb=str(cb)
                if cb in buttons and cb not in hidden and cb not in used:
                    out.append(buttons[cb]); used.add(cb)
            if out: result.append(out)
        for cb,b in buttons.items():
            if cb not in used and cb not in hidden:
                result.append([b])
        result.extend([[b] for b in plain])
        markup.keyboard.clear()
        markup.keyboard.extend(result)
        return markup

    order=[str(x) for x in cfg.get("order", [])]
    result=[]; used=set()
    for cb in order:
        if cb in buttons and cb not in hidden:
            result.append(buttons[cb]); used.add(cb)
    for cb,b in buttons.items():
        if cb not in used and cb not in hidden:
            result.append(b)
    result.extend(plain)
    cols=max(1,min(int(cfg.get("columns",1) or 1),3))
    new_keyboard = [result[i:i+cols] for i in range(0, len(result), cols)]
    markup.keyboard.clear()
    markup.keyboard.extend(new_keyboard)
    return markup

