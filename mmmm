def show_service_prices(): return get_ui_setting(UI_PRICE_SETTING_KEY, "0") == "1"

def get_service_display_price(service):
    """السعر الظاهر على زر الخدمة.
    للخدمات ذات tiers/custom_tiers نعرض سعر أول باقة بدلاً من 0.
    للخدمات العادية نستخدم price.
    """
    if not isinstance(service, dict):
        return 0

    for key in ("tiers", "custom_tiers"):
        tiers = service.get(key)
        if isinstance(tiers, list) and tiers:
            prices = []
            for tier in tiers:
                try:
                    price = float(tier.get("price"))
                    if price >= 0:
                        prices.append(price)
                except (TypeError, ValueError, AttributeError):
                    continue
            if prices:
                return min(prices)

    try:
        return float(service.get("price", 0) or 0)
    except (TypeError, ValueError):
        return 0


