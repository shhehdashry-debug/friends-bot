MAINTENANCE_CACHE = {"value": False, "time": 0}
MAINTENANCE_CACHE_TTL = 10  # ثواني

def is_maintenance(force_refresh=False):
    now = time.time()
    if not force_refresh and now - MAINTENANCE_CACHE["time"] < MAINTENANCE_CACHE_TTL:
        return MAINTENANCE_CACHE["value"]
    try:
        res = supabase.table("settings").select("val").eq("key", "maintenance").execute()
        value = bool(res.data[0]['val']) if res.data else False
        MAINTENANCE_CACHE.update({"value": value, "time": now})
        return value
    except Exception:
        return MAINTENANCE_CACHE["value"]

def toggle_maintenance():
    curr = is_maintenance(force_refresh=True)
    new_val = 0 if curr else 1
    try:
        supabase.table("settings").upsert({"key": "maintenance", "val": new_val}).execute()
        MAINTENANCE_CACHE.update({"value": bool(new_val), "time": time.time()})
    except Exception as e:
        print(f"Error toggling maintenance: {e}")
    return new_val

