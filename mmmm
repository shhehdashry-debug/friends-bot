def handle_select_charge_amount(call):
    chat_id = call.message.chat.id
    amount = float(call.data.split("_")[-1])
    receiver_phone = user_recharge_states.get(chat_id, {}).get('verified_asia_phone')
    
    if not receiver_phone:
        bot.send_message(chat_id, "❌ يرجى تأكيد رقم هاتفك أولاً.")
        return
    if not admin_asia_data['admin_asia_access_token']:
        bot.send_message(chat_id, "❌ نظام الشحن التلقائي غير مفعل من قبل الإدارة حالياً.")
        bot.send_message(ADMIN_ID, f"⚠️ المستخدم {chat_id} حاول الشحن بمبلغ {amount}$ ولكن رقم المالك (آسيا سيل) غير مسجل في البوت.")
        return

    try:
        data_start = send_asia_credit_transfer_start_request(amount, receiver_phone, admin_asia_data['admin_asia_access_token'])
        if data_start.get("success") or "PID" in data_start:
            transfer_pid = data_start.get("PID")
            if not transfer_pid and data_start.get("nextUrl"):
                match = re.search(r'PID=([a-f0-9\-]+)', data_start["nextUrl"])
                if match: transfer_pid = match.group(1)

            admin_asia_data['pending_transfers'][chat_id] = {
                'amount': amount,
                'receiver_phone': receiver_phone,
                'transfer_pid': transfer_pid,
                'timestamp': datetime.now()
            }
            bot.send_message(chat_id, f"⏳ تم إرسال طلب شحن بمبلغ {amount}$. انتظر قليلاً ريثما تتم الموافقة.")
            
            markup_admin = types.InlineKeyboardMarkup()
            markup_admin.add(types.InlineKeyboardButton("موافقة وتأكيد الشحن", callback_data=f"admin_approve_transfer_{chat_id}", style=get_item_style(f"admin_approve_transfer_{chat_id}")))
            bot.send_message(ADMIN_ID, f"🔔 طلب شحن جديد من المستخدم `{chat_id}`\nالمبلغ: {amount}$\nالرقم: {receiver_phone}", reply_markup=markup_admin, parse_mode="Markdown")
        else:
            bot.send_message(chat_id, f"❌ فشل بدء التحويل: {data_start.get('message', data_start)}")
    except Exception as e:
        bot.send_message(chat_id, f"❌ خطأ فني: {e}")

