def calculate_bulk_discount_price(base_rate_per_1000, quantity):
    """حساب سعر الكمية مع خصم الكميات، قبل خصم رتبة المستخدم."""
    try:
        base_rate = float(base_rate_per_1000 or 0)
        qty = int(quantity)
    except (TypeError, ValueError):
        return 0.0

    if qty >= 20000:
        discount_pct = 10
    elif qty >= 10000:
        discount_pct = 7
    elif qty >= 5000:
        discount_pct = 5
    else:
        discount_pct = 0

    total_price = (qty / 1000.0) * base_rate
    total_price *= (1 - discount_pct / 100.0)
    return round(total_price, 2)

