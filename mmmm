CUSTOM_LINK_BUTTONS_KEY = "custom_link_buttons_v1"
_CUSTOM_LINK_BUTTONS_CACHE = None


def _load_custom_link_buttons():
    global _CUSTOM_LINK_BUTTONS_CACHE
    if _CUSTOM_LINK_BUTTONS_CACHE is not None:
        return _CUSTOM_LINK_BUTTONS_CACHE
    try:
        res = supabase.table("settings").select("val_text").eq("key", CUSTOM_LINK_BUTTONS_KEY).execute()
        raw = res.data[0].get("val_text") if res.data else ""
        data = json.loads(raw) if raw else []
        _CUSTOM_LINK_BUTTONS_CACHE = data if isinstance(data, list) else []
    except Exception as e:
        print(f"Custom link buttons load error: {e}")
        _CUSTOM_LINK_BUTTONS_CACHE = []
    return _CUSTOM_LINK_BUTTONS_CACHE


def _save_custom_link_buttons(items):
    global _CUSTOM_LINK_BUTTONS_CACHE
    clean = []
    for item in items:
        if not isinstance(item, dict):
            continue
        item = dict(item)
        item.setdefault("id", uuid.uuid4().hex[:10])
        item.setdefault("name", "زر جديد")
        item.setdefault("links", [])
        if not isinstance(item["links"], list):
            item["links"] = []
        clean_links = []
        for link in item["links"]:
            if not isinstance(link, dict):
                continue
            name = str(link.get("name", "")).strip()
            url = str(link.get("url", "")).strip()
            if name and re.match(r"^https?://", url, re.I):
                clean_links.append({"name": name[:60], "url": url[:400]})
        item["name"] = str(item["name"]).strip()[:60] or "زر جديد"
        item["links"] = clean_links
        clean.append(item)
    supabase.table("settings").upsert({
        "key": CUSTOM_LINK_BUTTONS_KEY,
        "val_text": json.dumps(clean, ensure_ascii=False)
    }).execute()
    _CUSTOM_LINK_BUTTONS_CACHE = clean
    return clean


def _custom_link_item(item_id):
    return next((x for x in _load_custom_link_buttons() if str(x.get("id")) == str(item_id)), None)


