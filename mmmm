def check_provider_connection(provider):
    started = time.time()
    try:
        if provider == "primary":
            if not API_KEY:
                return False, "🔴 API Key غير موجود", 0.0
            response = http_session.post(
                API_URL,
                data={"key": API_KEY, "action": "balance"},
                timeout=12
            )
            data = response.json()
        elif provider == "kd1s":
            if not API2_KEY:
                return False, "🔴 KD1S_API_KEY غير مضبوط", 0.0
            data = kd1s_request("balance")
        else:
            return False, "🔴 مزود غير معروف", 0.0

        elapsed = round(time.time() - started, 2)

        if isinstance(data, dict) and data.get("error"):
            return False, f"🔴 {str(data['error'])[:180]}", elapsed

        if isinstance(data, dict) and "balance" in data:
            balance = data.get("balance", "")
            currency = data.get("currency", "")
            return True, f"🟢 متصل | الرصيد: {balance} {currency}".strip(), elapsed

        return False, "🟠 السيرفر رد لكن بصيغة غير متوقعة", elapsed
    except Exception as e:
        return False, f"🔴 فشل الاتصال: {str(e)[:180]}", round(time.time() - started, 2)


def check_all_api_connections():
    p_ok, p_msg, p_time = check_provider_connection("primary")
    k_ok, k_msg, k_time = check_provider_connection("kd1s")
