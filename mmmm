def _advanced_service_callback_v2(call):
    data = call.data
    chat_id = call.from_user.id

    if chat_id != ADMIN_ID:
        return False

    if data.startswith("toggle_srv_"):
        key = data[len("toggle_srv_"):]
        if key not in SERVICES:
            bot.answer_callback_query(call.id, "❌ الخدمة غير موجودة.", show_alert=True)
            return True
        paused = not service_is_paused(SERVICES[key])
        set_service_paused(key, paused)
        bot.answer_callback_query(
            call.id,
            "⏸️ تم إيقاف الخدمة" if paused else "▶️ تم تفعيل الخدمة"
        )
        return True

    if data.startswith("copy_srv_"):
        key = data[len("copy_srv_"):]
        if key not in SERVICES:
            bot.answer_callback_query(call.id, "❌ الخدمة غير موجودة.", show_alert=True)
            return True
        import secrets
        new_key = f"{key}_copy_{secrets.token_hex(2)}"
        clone_service(key, new_key)
        bot.answer_callback_query(call.id, "✅ تم نسخ الخدمة.")
        return True

    if data.startswith("edit_srv_"):
        key = data[len("edit_srv_"):]
        if key not in SERVICES:
            bot.answer_callback_query(call.id, "❌ الخدمة غير موجودة.", show_alert=True)
            return True
        bot.answer_callback_query(
            call.id,
            "✏️ افتح تعديل الخدمة من لوحة إدارة الخدمات."
        )
        return True

    if data == "recharge_create":
        bot.answer_callback_query(call.id)
        bot.send_message(
            chat_id,
            "➕ إنشاء أكواد شحن\n\n"
            "أرسل العدد والقيمة هكذا:\n"
            "10:5\n\n"
            "يعني 10 أكواد، قيمة كل كود 5 نقاط."
        )
        return True

    if data == "recharge_manage":
        bot.answer_callback_query(call.id)
        _show_recharge_codes_admin(chat_id)
        return True

    if data.startswith("recharge_code_info|"):
        code = data.split("|", 1)[1]
        try:
            res = supabase.table("vouchers").select("*").eq("code", code).execute()
            row = res.data[0] if res.data else None
        except Exception:
            row = None
        if not row:
            bot.answer_callback_query(call.id, "❌ الكود غير موجود.", show_alert=True)
            return True
        amount = row.get("amount", 0)
        bot.answer_callback_query(call.id, f"🎟️ {code} — {amount} نقطة", show_alert=True)
        return True

    return False

