SMART_MAINT_ITEMS_KEY = "smart_maintenance_items"

def _load_maintenance_items():
    """تحميل الخدمات الموجودة تحت الصيانة من Supabase."""
    global maintenance_items
    try:
        r = supabase.table("settings").select("val_text").eq("key", SMART_MAINT_ITEMS_KEY).execute()
        if r.data and r.data[0].get("val_text"):
            raw = json.loads(str(r.data[0]["val_text"]))
            if isinstance(raw, list):
                maintenance_items = set(str(x) for x in raw)
    except Exception as e:
        print(f"Smart maintenance load error: {e}")
    return maintenance_items

def _save_maintenance_items():
    """حفظ قائمة الخدمات تحت الصيانة بشكل دائم."""
    try:
        supabase.table("settings").upsert({
            "key": SMART_MAINT_ITEMS_KEY,
            "val_text": json.dumps(sorted(maintenance_items), ensure_ascii=False)
        }, on_conflict="key").execute()
        return True
    except Exception as e:
        print(f"Smart maintenance save error: {e}")
        return False

def is_item_in_maintenance(item_key):
    return str(item_key) in maintenance_items

def toggle_item_maintenance(item_key):
    item_key = str(item_key)
    if item_key in maintenance_items:
        maintenance_items.remove(item_key)
        enabled = False
    else:
        maintenance_items.add(item_key)
        enabled = True
    _save_maintenance_items()
    return enabled

