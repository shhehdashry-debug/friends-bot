            _save_button_layouts(all_data)

            bot.answer_callback_query(call.id, "✅ تم تغيير سعة الصف")
            _show_layout_editor(
                call.message.chat.id, call.message.message_id, key
            )
            return True

        # توافق مع النسخة القديمة: إذا وصل callback قديم نفتح التحكم.
        if data.startswith("layout_pick|"):
            _, key, idx = data.split("|", 2)
            _show_layout_item(call, key, int(idx))
            return True

        if data.startswith("layout_move|"):
            # القديم كان يعتمد order فقط؛ نحوله إلى تحريك صف آمن.
            _, key, idx, direction = data.split("|", 3)
            cfg = _normalize_layout_cfg(key)
            rows = cfg.get("rows", [])
            idx = int(idx)
            if 0 <= idx < len(rows):
                _show_layout_item(call, key, idx)
            return True

        if data.startswith("layout_hide|"):
            _, key, idx = data.split("|", 2)
            cfg = _normalize_layout_cfg(key)
            order = cfg.get("order", [])
            idx = int(idx)
            if 0 <= idx < len(order):
                cb = order[idx]
                all_data = dict(_load_button_layouts())
                cfg = dict(all_data.get(key, {}))
                hidden = set(cfg.get("hidden", []))
                if cb in hidden:
                    hidden.remove(cb)
                    msg = "✅ تم إظهار الزر"
