            'price': price,
            'qty': 1,
            'is_custom_tiers': False
        }
        
        SERVICES[key] = service_payload
        
        try:
            supabase.table("custom_services").upsert({
                "service_key": key,
                "category": category_val,
                "subcat": subcat_val,
                "service_data": json.dumps(service_payload, ensure_ascii=False)
            }, on_conflict="service_key").execute()
        except Exception as db_err:
            print(f"Error saving manual service to Supabase: {db_err}")
        
