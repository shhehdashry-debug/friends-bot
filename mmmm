KD1S_SERVICES_CACHE = {"time": 0.0, "data": {}}
KD1S_SERVICES_TTL = 300

def kd1s_request(action, **kwargs):
    if not API2_KEY:
        return {"error": "KD1S_API_KEY غير مضبوط في Environment Variables"}
    payload = {"key": API2_KEY, "action": action}
    payload.update({k: v for k, v in kwargs.items() if v is not None})
    try:
        response = http_session.post(API2_URL, data=payload, timeout=20)
        response.raise_for_status()
        return response.json()
    except Exception as e:
        return {"error": str(e)}

def kd1s_services(force=False):
    now = time.time()
    if not force and KD1S_SERVICES_CACHE["data"] and now - KD1S_SERVICES_CACHE["time"] < KD1S_SERVICES_TTL:
        return KD1S_SERVICES_CACHE["data"]
    result = kd1s_request("services")
    if isinstance(result, list):
        KD1S_SERVICES_CACHE["data"] = {
            str(item.get("service")): item
            for item in result
            if isinstance(item, dict) and item.get("service") is not None
        }
        KD1S_SERVICES_CACHE["time"] = now
    return KD1S_SERVICES_CACHE["data"]

def kd1s_add_order(service_id, link, quantity):
    return kd1s_request("add", service=str(service_id), link=str(link), quantity=str(quantity))

def kd1s_status(order_id):
