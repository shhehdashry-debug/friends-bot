            all_data = dict(_load_button_layouts())
            cfg = dict(all_data.get(key, {}))
            rows = [list(r) for r in cfg.get("rows", [])]
            target = idx - 1 if direction == "up" else idx + 1

            if 0 <= idx < len(rows) and 0 <= target < len(rows):
                rows[idx], rows[target] = rows[target], rows[idx]
                cfg["rows"] = rows
                cfg["order"] = [x for r in rows for x in r]
                all_data[key] = cfg
                _save_button_layouts(all_data)

            bot.answer_callback_query(call.id, "✅ تم تحريك الصف")
            _show_layout_editor(
                call.message.chat.id, call.message.message_id, key
            )
            return True

        if data.startswith("layout_unpair|"):
            _, key, idx = data.split("|", 2)
            idx = int(idx)
            all_data = dict(_load_button_layouts())
            cfg = dict(all_data.get(key, {}))
            rows = [list(r) for r in cfg.get("rows", [])]

            if 0 <= idx < len(rows) and len(rows[idx]) > 1:
                row = rows.pop(idx)
                for cb in reversed(row):
                    rows.insert(idx, [cb])

            cfg["rows"] = rows
            cfg["order"] = [x for r in rows for x in r]
            all_data[key] = cfg
            _save_button_layouts(all_data)

            bot.answer_callback_query(call.id, "✂️ تم فصل الأزرار")
            _show_layout_editor(
                call.message.chat.id, call.message.message_id, key
            )
            return True

        if data.startswith("layout_hide_menu|"):
            key = data.split("|", 1)[1]
            _show_layout_hide_buttons(call, key)
            return True

        if data.startswith("layout_hide_cb|"):
            parts = data.split("|")
            if len(parts) == 4:
                _, key, row_s, col_s = parts
                cfg = _normalize_layout_cfg(key)
                cb = _layout_cb_at(cfg, row_s, col_s)
                if not cb:
                    bot.answer_callback_query(call.id, "❌ الزر غير موجود", show_alert=True)
                    return True
            else:
                # توافق مع callback قديم.
                _, key, cb = data.split("|", 2)
                cfg = _normalize_layout_cfg(key)

            all_data = dict(_load_button_layouts())
            cfg = dict(all_data.get(key, {}))
            hidden = set(cfg.get("hidden", []))

            if cb in hidden:
                hidden.remove(cb)
                msg = "✅ تم إظهار الزر"
            else:
                hidden.add(cb)
                msg = "🚫 تم إخفاء الزر"

            cfg["hidden"] = list(hidden)
            all_data[key] = cfg
            _save_button_layouts(all_data)

            bot.answer_callback_query(call.id, msg, show_alert=True)
            _show_layout_hide_buttons(call, key)
            return True

        if data.startswith("layout_reset|"):
            key = data.split("|", 1)[1]
            all_data = dict(_load_button_layouts())
            cfg = dict(all_data.get(key, {}))
            cfg["order"] = [x.get("callback") for x in cfg.get("buttons", []) if x.get("callback")]
            cfg["rows"] = [[x] for x in cfg["order"]]
            cfg["hidden"] = []
            cfg["columns"] = 1
            all_data[key] = cfg
            _save_button_layouts(all_data)

            bot.answer_callback_query(call.id, "♻️ تم إرجاع الترتيب الافتراضي")
            _show_layout_editor(
                call.message.chat.id, call.message.message_id, key
            )
            return True

        if data.startswith("layout_cols|"):
            _, key, cols = data.split("|", 2)
            all_data = dict(_load_button_layouts())
            cfg = dict(all_data.get(key, {}))
            cfg["columns"] = max(1, min(int(cols), 3))
