            else:
                _, key, first = data.split("|", 2)
                cfg = _normalize_layout_cfg(key)
                pos = next(((ri, ci) for ri, rr in enumerate(cfg.get("rows", [])) for ci, x in enumerate(rr) if x == first), None)
                if pos:
                    first_row, first_col = str(pos[0]), str(pos[1])
                else:
                    first_row, first_col = "-1", "-1"
            if not first:
                bot.answer_callback_query(call.id, "❌ الزر غير موجود", show_alert=True)
