def _normalize_layout_cfg(key):
    """تنظيف rows/order/hidden حتى لا تبقى إعدادات قديمة متعارضة."""
    data = dict(_load_button_layouts())
    cfg = dict(data.get(key, {}))
    buttons = [str(x.get("callback")) for x in cfg.get("buttons", []) if x.get("callback")]
    live = set(buttons)

    rows = []
    seen = set()
    for row in cfg.get("rows", []):
        clean = []
        for cb in row:
            cb = str(cb)
            if cb in live and cb not in seen:
                clean.append(cb)
                seen.add(cb)
        if clean:
            rows.append(clean)

    # أي زر جديد/غير محفوظ يضاف منفرداً.
    for cb in buttons:
        if cb not in seen:
            rows.append([cb])
            seen.add(cb)

    hidden = [str(x) for x in cfg.get("hidden", []) if str(x) in live]
    cfg["rows"] = rows
    cfg["order"] = [cb for row in rows for cb in row]
    cfg["hidden"] = hidden
    cfg["columns"] = max(1, min(int(cfg.get("columns", 1) or 1), 3))
    data[key] = cfg
    _save_button_layouts(data)
    return cfg


